{
  "name": "flashai-desktop",
  "version": "2.0.1",
  "description": "FLASHAI 无限画布 AI 创作平台 — 桌面客户端 (Electron)",
  "main": "main.js",
  "homepage": "https://github.com/invaders-2/FLASHAI",
  "author": {
    "name": "FLASHAI",
    "email": "271007236+invaders-2@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:publish": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.flashai.desktop",
    "productName": "FLASHAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "source-drag-preload.js",
      "package.json"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "extraResources": [
      {
        "from": "../main.py",
        "to": "backend/main.py"
      },
      {
        "from": "../prompt_intelligence.py",
        "to": "backend/prompt_intelligence.py"
      },
      {
        "from": "../requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../static",
        "to": "backend/static"
      },
      {
        "from": "../server",
        "to": "backend/server"
      },
      {
        "from": "../config",
        "to": "backend/config"
      },
      {
        "from": "../workflows",
        "to": "backend/workflows"
      },
      {
        "from": ".version",
        "to": "backend/VERSION"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "invaders-2",
        "repo": "FLASHAI-Infinite-Canvas",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "artifactName": "FLASHAI-Electron-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FLASHAI"
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Graphics",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^24.13.3"
  }
}
